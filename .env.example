# Вариант A: без OpenBao — заполнить секреты прямо здесь (для локальной разработки).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_IDS=
GITHUB_TOKEN=
GITLAB_TOKEN=
GROQ_API_KEY=

# Вариант B: секреты в OpenBao — оставить поля выше пустыми, задать:
# OPENBAO_ADDR=http://openbao:8200
# Токен приложения (OPENBAO_TOKEN) кладётся в .env.openbao —
# генерируется автоматически scripts/openbao_bootstrap.sh, в git не попадает.
OPENBAO_ADDR=

DATABASE_PATH=./data/bot.db
LOG_LEVEL=INFO
SENTRY_DSN=
